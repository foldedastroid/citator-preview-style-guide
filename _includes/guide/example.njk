
{%- set exId = "code-" ~ (ex | replace("/", "-")) -%}
{%- set export = ex | exampleInfo -%}
{%- if exOpinion -%}{%- set opinion = allOpinions | opinionById(exOpinion) -%}{%- endif -%}
<figure class="g-example">
  <div class="g-example__stage {{ exStage }}" x-data="guideStage">
    {% include "examples/" ~ ex ~ ".njk" %}
  </div>
  <figcaption class="g-example__bar">
    <span class="g-example__title">{{ exTitle or "Example" }}</span>
    <span class="g-example__file">src/examples/{{ ex }}.njk · {{ export.kind }}</span>
    <button type="button" class="g-text-button" data-copy="{{ exId }}">Copy page</button>
  </figcaption>
  <div class="g-prose px-4 py-3"><p>{{ export.note }} Save the complete copied file under <code>src/examples/</code> in the app. The live fragment is <code>_includes/examples/{{ ex }}.njk</code>.{% if export.opinionId %} Setup selects preview record <code>{{ export.opinionId }}</code>; choose an available record for your own collection. A missing record renders an explicit setup message.{% endif %}</p></div>
  <pre class="g-code" id="{{ exId }}"><code>{{ ex | exampleSource }}</code></pre>
</figure>
{%- set exTitle = "" -%}{%- set exStage = "" -%}{%- set exOpinion = "" -%}
