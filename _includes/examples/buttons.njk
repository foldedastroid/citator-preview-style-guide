{% from "macros/icons.njk" import icon %}
<div class="flex flex-wrap items-center gap-3">
  <a href="#" class="start-panel__button !mt-0">{{ icon("search", "w-4 h-4") }}Search opinions</a>
  <button type="button" class="doc-action">{{ icon("document", "w-3.5 h-3.5") }}<span class="doc-action__label">Copy citation</span></button>
  <a href="https://www.courtlistener.com/" class="doc-action" target="_blank" rel="noopener">{{ icon("external", "w-3.5 h-3.5") }}CourtListener</a>
  <button type="button" class="doc-action" disabled>{{ icon("document", "w-3.5 h-3.5") }}Unavailable</button>
</div>
<p class="mt-5 text-sm text-greyscale-700">
  A <a href="#" class="links">text link</a> inside prose, and a
  <a href="https://free.law/" class="links" target="_blank" rel="noopener">link that opens a new tab {{ icon("external", "inline w-3 h-3") }}</a>.
</p>
