<div class="flex flex-wrap gap-3">
  <button type="button" class="doc-action" data-toast="Citation copied" data-toast-intent="positive">Positive</button>
  <button type="button" class="doc-action" data-toast="Continue where you left off" data-toast-message="At Part II" data-toast-action="Continue" data-toast-duration="8000">With an action</button>
  <button type="button" class="doc-action" data-toast="Copy failed" data-toast-message="Select the text and copy it instead." data-toast-intent="destructive">Destructive</button>
  <button type="button" class="doc-action" data-toast="Stays until dismissed" data-toast-duration="0">Persistent</button>
</div>
