{% from "macros/pagination.njk" import pagination %}
<section x-data="searchFilter" class="px-1 py-5 sm:p-6">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3 px-3">
    <h3 class="m-0 text-sm font-medium">Illustrative results</h3>
    <button type="button" class="doc-action" x-on:click="clearAllFilters">Reset example</button>
  </div>
  <p class="mb-3 px-3 text-xs text-greyscale-500" role="status" aria-live="polite"><span x-text="visibleCount">93</span> results</p>
  <ol role="list" class="home-list">
    {% for n in range(1, 94) %}
    <li class="home-row px-3" data-court="fixture" data-tier="anchor" data-search="illustrativeresult{{ n }}" data-dh-severity="neutral" data-cr-severity="neutral" data-date="2025-01-01" data-name="illustrative result {{ n }}" data-court-level="1" x-show="rowVisible">
      <p class="text-sm">Illustrative result {{ n }}</p>
    </li>
    {% endfor %}
  </ol>
  {{ pagination("Illustrative results", "illustrative-pages") }}
</section>
