{
  "name": "citator-preview-style-guide",
  "version": "0.1.0",
  "private": true,
  "description": "My style guide for the Citator preview, with live Nunjucks components and shared design tokens.",
  "scripts": {
    "sync": "node tools/sync-app.cjs ../citator-app",
    "check:sync": "node tools/sync-app.cjs ../citator-app --check",
    "build:css": "tailwindcss -i assets/css/styles.css -o _site/assets/css/styles.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "dev:css": "tailwindcss -i assets/css/styles.css -o _site/assets/css/styles.css --watch",
    "dev:eleventy": "eleventy --serve",
    "dev": "npm run build:css && (npm run dev:css & npm run dev:eleventy)",
    "test": "node --test tools/*.test.cjs",
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@alpinejs/csp": "3.15.9",
    "tailwindcss": "^3.4.0"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foldedastroid/citator-preview-style-guide.git"
  }
}
