---
layout: false
permalink: /assets/guide/accent.css
eleventyExcludeFromCollections: true
---
:root {
  --g-link: {{ theme.extend.colors.primary[600] }};
  --g-link-hover: {{ theme.extend.colors.primary[700] }};
  --g-focus: {{ theme.extend.colors.primary[600] }};
  --g-selected: {{ theme.extend.colors.primary[50] }};
  --g-selection: {{ theme.extend.colors.primary[100] }};
  --g-sidebar-duration: {{ theme.extend.transitionDuration.popover }};
  --g-ease: {{ theme.extend.transitionTimingFunction.standard }};
}
