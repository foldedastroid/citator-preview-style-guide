<h2 class="g-h2" id="durations">Durations</h2>
{{ table(["Utility", "Value", "Used for"], [
  ["<code>duration-feedback</code>", "<code>" ~ t.transitionDuration.feedback ~ "</code>", "Colour and background changes on hover, press and selection"],
  ["<code>duration-popover</code>", "<code>" ~ t.transitionDuration.popover ~ "</code>", "Menus, popovers and tooltips appearing"],
